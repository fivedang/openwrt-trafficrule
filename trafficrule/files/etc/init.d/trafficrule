#!/bin/sh /etc/rc.common
# trafficrule - traffic capture to OpenClash rule service

START=99
STOP=10
USE_PROCD=1

EXTRA_COMMANDS="status"
EXTRA_HELP="	status	Show service status"

start_service() {
    local enabled target_ip interface

    config_load trafficrule
    config_get enabled global enabled "0"
    config_get target_ip global target_ip ""
    config_get interface global interface "br-lan"

    [ "$enabled" = "1" ] || {
        echo "trafficrule is disabled. Set enabled=1 in UCI config."
        return 0
    }

    [ -n "$target_ip" ] || {
        echo "Error: target_ip is not configured."
        return 1
    }

    mkdir -p /tmp/trafficrule/sessions
    mkdir -p /etc/trafficrule/sessions

    procd_open_instance trafficrule
    procd_set_param command /usr/bin/trafficrule-capture
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile /var/run/trafficrule.pid
    procd_close_instance
}

stop_service() {
    local pid_dir="/tmp/trafficrule"

    # Kill tcpdump children via PID files (reliable method)
    local pidfile
    for pidfile in "$pid_dir/dns.pid" "$pid_dir/sni.pid" "$pid_dir/ip.pid"; do
        if [ -f "$pidfile" ]; then
            local pid
            pid="$(cat "$pidfile" 2>/dev/null)"
            if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
                kill "$pid" 2>/dev/null
            fi
            rm -f "$pidfile"
        fi
    done

    # Kill the capture script itself
    local pids
    pids="$(pgrep -f 'trafficrule-capture' 2>/dev/null)"
    [ -n "$pids" ] && kill $pids 2>/dev/null

    # Fallback: kill any remaining tcpdump on the monitored interface
    killall tcpdump 2>/dev/null || true
}

service_triggers() {
    procd_add_reload_trigger "trafficrule"
}
